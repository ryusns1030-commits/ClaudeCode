{"fps": 30, "durationInFrames": 1334, "durationSec": 44.467, "speechEndFrame": 1303, "scenes": [{"id": "hook", "from": 0, "duration": 198}, {"id": "experience", "from": 198, "duration": 343}, {"id": "prompt", "from": 541, "duration": 297}, {"id": "check", "from": 838, "duration": 160}, {"id": "conclusion", "from": 998, "duration": 211}, {"id": "ending", "from": 1209, "duration": 125}], "subtitles": [{"id": "L01", "text": "英訳した営業メール、そのまま送ってない？", "from": 4, "to": 83, "scene": "hook", "subLines": [], "emphasis": ["そのまま"], "emphasisColor": "cyan"}, {"id": "L02", "text": "頼み方3つと、送る前のチェック5つ。", "from": 87, "to": 189, "scene": "hook", "subLines": ["頼み方3つと、", "送る前のチェック5つ。"], "emphasis": ["3つ", "5つ"], "emphasisColor": "cyan"}, {"id": "L03", "text": "2024年、ChatGPTで英訳しました。", "from": 207, "to": 312, "scene": "experience", "subLines": [], "emphasis": ["2024年", "ChatGPT"], "emphasisColor": "cyan"}, {"id": "L04", "text": "件名は“相手のメリット”型に。別案には、お詫びも。", "from": 316, "to": 430, "scene": "experience", "subLines": [], "emphasis": ["相手のメリット", "お詫び"], "emphasisColor": "cyan"}, {"id": "L05", "text": "ただ、送信や返信は未確認。", "from": 434, "to": 512, "scene": "experience", "subLines": [], "emphasis": ["未確認"], "emphasisColor": "coral"}, {"id": "L07", "text": "頼むときは ① 読み手と場面を書く。", "from": 550, "to": 650, "scene": "prompt", "subLines": ["頼むときは", "① 読み手と場面を書く。"], "emphasis": ["読み手と場面"], "emphasisColor": "cyan"}, {"id": "L08", "text": "② 元にない実績は、足さない。", "from": 654, "to": 728, "scene": "prompt", "subLines": [], "emphasis": ["足さない"], "emphasisColor": "cyan"}, {"id": "L09", "text": "③ 意味が変わる所は、日本語で説明させる。", "from": 733, "to": 830, "scene": "prompt", "subLines": [], "emphasis": ["日本語で説明"], "emphasisColor": "cyan"}, {"id": "L10", "text": "送る前は、この5項目をチェック。", "from": 847, "to": 924, "scene": "check", "subLines": [], "emphasis": ["5項目"], "emphasisColor": "cyan"}, {"id": "L11", "text": "文章の完成と、営業の成果は別。", "from": 1007, "to": 1098, "scene": "conclusion", "subLines": [], "emphasis": ["完成", "成果"], "emphasisColor": "cyan